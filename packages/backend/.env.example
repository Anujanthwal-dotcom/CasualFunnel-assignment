# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/casualfunnel

# CORS: comma-separated allowed origins, or * for any (dev only).
# A page opened from file:// sends `Origin: null`, so use * in local development.
CORS_ORIGINS=*

# Optional shared secret. When set, POST /api/events requires an `x-api-key` header.
API_KEY=

# Heatmap query cap (maximum click points returned per request).
HEATMAP_MAX_POINTS=20000

# Rate limiting: requests per window per IP.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=5000

# Seed helper: number of sessions to generate (npm run seed).
SEED_SESSIONS=18
